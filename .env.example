# Replace this value before exposing the application beyond your local machine.
RESOLVEIT_SECRET_KEY=change-this-to-a-long-random-secret
RESOLVEIT_DATABASE_URL=sqlite:///./resolveit.db
RESOLVEIT_ACCESS_TOKEN_MINUTES=60

# Local demo bootstrap accounts. Change these passwords for any shared environment.
RESOLVEIT_ADMIN_EMAIL=admin@resolveit.local
RESOLVEIT_ADMIN_PASSWORD=Admin123!
RESOLVEIT_AGENT_EMAIL=agent@resolveit.local
RESOLVEIT_AGENT_PASSWORD=Agent123!
